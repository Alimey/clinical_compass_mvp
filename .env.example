# Local configuration. Copy to .env; keep credentials outside version control.
# Python 3.11+; the tested runtime is 3.12.
# COMPASS_DB=instance/compass.db
# COMPASS_HOST=127.0.0.1
# PORT=8000
# Enable only on HTTPS deployments, not ordinary local HTTP.
COMPASS_SECURE_COOKIES=0

# Name encryption: set a stable key on the server or use the local key file.
# Generate privately: python -m compass.name_crypto --generate-key
COMPASS_NAME_KEY=
# COMPASS_NAME_KEY_FILE=instance/patient-names.key

# OpenAI-compatible external API. BASE_URL ends with /v1 (not /chat/completions).
# Use your provider's documented URL and model identifier.
COMPASS_AI_BASE_URL=
COMPASS_AI_MODEL=
COMPASS_AI_API_KEY=

# Telegram: create a bot with BotFather; token stays on the server.
COMPASS_TELEGRAM_BOT_TOKEN=
COMPASS_TELEGRAM_BOT_USERNAME=
# An app URL users can actually open; localhost on a phone is that phone.
COMPASS_PUBLIC_URL=

# Reminder/escalation scheduler. python app.py starts it automatically.
# Leave 0 for local development; tests use 1 to avoid external integrations.
COMPASS_DISABLE_WORKER=0
COMPASS_ESCALATION_MINUTES=15
# Configure a real administrative contact for a deployed Web Push sender.
COMPASS_PUSH_CONTACT=mailto:demo@example.invalid

# Absence threshold and delay after an unmarked medication dose.
COMPASS_INACTIVITY_HOURS=72
COMPASS_MEDICATION_GRACE_MINUTES=30
